{
	"useTabs": true,
	"printWidth": 100,
	"singleQuote": false,
	"quoteProps": "as-needed",
	"semi": true,
	"jsxSingleQuote": false,
	"trailingComma": "all",
	"objectWrap": "preserve",
	"bracketSpacing": true,
	"bracketSameLine": false,
	"plugins": ["prettier-plugin-svelte", "prettier-plugin-tailwindcss"],
	"overrides": [
		{
			"files": "*.svelte",
			"options": {
				"parser": "svelte"
			}
		}
	],
	"tailwindStylesheet": "./src/routes/layout.css"
}
